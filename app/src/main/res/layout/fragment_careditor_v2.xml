<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:fillViewport="true"
	android:fitsSystemWindows="true"
	android:padding="16dp">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:scrollbars="vertical">

		<com.google.android.material.textfield.TextInputLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="5dp">

			<com.google.android.material.textfield.TextInputEditText
				android:id="@+id/txt_vehicle_id"
				android:layout_width="150dp"
				android:layout_height="wrap_content"
				android:hint="@string/lb_vehicle_id"
				android:inputType="textNoSuggestions|textCapCharacters">

				<requestFocus />
			</com.google.android.material.textfield.TextInputEditText>

		</com.google.android.material.textfield.TextInputLayout>

		<com.google.android.material.textfield.TextInputLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="5dp">

			<com.google.android.material.textfield.TextInputEditText
				android:id="@+id/txt_vehicle_label"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:hint="@string/lb_vehicle_label"
				android:inputType="textCapWords" />

		</com.google.android.material.textfield.TextInputLayout>

		<com.google.android.material.textfield.TextInputLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="5dp">

			<com.google.android.material.textfield.TextInputEditText
				android:id="@+id/txt_server_passwd"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:hint="@string/lb_server_passwd"
				android:inputType="textPassword" />

		</com.google.android.material.textfield.TextInputLayout>

		<com.google.android.material.textfield.TextInputLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="5dp">

			<com.google.android.material.textfield.TextInputEditText
				android:id="@+id/txt_module_passwd"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				android:hint="@string/lb_module_passwd"
				android:inputType="textPassword" />

		</com.google.android.material.textfield.TextInputLayout>

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:layout_marginBottom="12dp"
			android:text="@string/lb_select_server" />

		<com.google.android.material.textfield.TextInputLayout
			style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="5dp">

			<com.google.android.material.textfield.MaterialAutoCompleteTextView
				android:id="@+id/select_server"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:inputType="none" />

		</com.google.android.material.textfield.TextInputLayout>

		<com.google.android.material.textfield.TextInputLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="5dp">

			<com.google.android.material.textfield.TextInputEditText
				android:id="@+id/txt_server_address"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				android:layout_marginBottom="5dp"
				android:ems="10"
				android:hint="@string/ServerNameOrIP"
				android:inputType="text"
				android:text="" />

		</com.google.android.material.textfield.TextInputLayout>

		<com.google.android.material.textfield.TextInputLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginBottom="5dp">

			<com.google.android.material.textfield.TextInputEditText
				android:id="@+id/txt_gcm_senderid"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_gravity="center_horizontal"
				android:layout_marginTop="8dp"
				android:ems="10"
				android:hint="@string/GcmSenderID"
				android:inputType="number" />

		</com.google.android.material.textfield.TextInputLayout>

		<com.google.android.material.switchmaterial.SwitchMaterial
			android:id="@+id/chk_tls_enabled"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:text="@string/lb_tls_enabled" />

		<com.google.android.material.switchmaterial.SwitchMaterial
			android:id="@+id/chk_tls_trust_all"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginStart="20dp"
			android:text="@string/lb_tls_trust_all" />

		<View
			android:layout_width="match_parent"
			android:layout_height="1dp"
			android:layout_marginTop="16dp"
			android:layout_marginBottom="16dp"
			android:background="?android:attr/listDivider" />

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/lb_control_page_view_car"
			android:textAppearance="?attr/textAppearanceTitleMedium" />

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:text="@string/lb_slide_choice_vehicle" />

		<Gallery
			android:id="@+id/ga_car"
			android:layout_width="match_parent"
			android:layout_height="100dp"
			android:spacing="20dp" />

		<ImageView
			android:id="@+id/img_custom_preview"
			android:layout_width="100dp"
			android:layout_height="100dp"
			android:layout_gravity="center_horizontal"
			android:layout_marginTop="8dp"
			android:scaleType="centerInside"
			android:visibility="gone" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btn_custom_image"
			style="@style/Widget.Material3.Button.TonalButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_horizontal"
			android:layout_marginTop="8dp"
			android:text="@string/btn_custom_image" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btn_clear_custom_image"
			style="@style/Widget.Material3.Button.TextButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_horizontal"
			android:text="@string/btn_clear_custom_image"
			android:visibility="gone" />

		<View
			android:layout_width="match_parent"
			android:layout_height="1dp"
			android:layout_marginTop="16dp"
			android:layout_marginBottom="16dp"
			android:background="?android:attr/listDivider" />

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/lb_control_page_view"
			android:textAppearance="?attr/textAppearanceTitleMedium" />

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:text="@string/lb_control_page_view_desc" />

		<Gallery
			android:id="@+id/ga_car_ol"
			android:layout_width="match_parent"
			android:layout_height="100dp"
			android:layout_marginTop="8dp"
			android:spacing="20dp" />

		<ImageView
			android:id="@+id/img_custom_preview_ol"
			android:layout_width="100dp"
			android:layout_height="100dp"
			android:layout_gravity="center_horizontal"
			android:layout_marginTop="8dp"
			android:scaleType="centerInside"
			android:visibility="gone" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btn_custom_image_ol"
			style="@style/Widget.Material3.Button.TonalButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_horizontal"
			android:layout_marginTop="8dp"
			android:text="@string/btn_custom_top_view" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btn_clear_custom_image_ol"
			style="@style/Widget.Material3.Button.TextButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_horizontal"
			android:text="@string/btn_clear_custom_top_view"
			android:visibility="gone" />

		<View
			android:layout_width="match_parent"
			android:layout_height="1dp"
			android:layout_marginTop="16dp"
			android:layout_marginBottom="16dp"
			android:background="?android:attr/listDivider" />

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="@string/lb_map_icon_view"
			android:textAppearance="?attr/textAppearanceTitleMedium" />

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:text="@string/lb_map_icon_view_desc" />

		<Gallery
			android:id="@+id/ga_car_map"
			android:layout_width="match_parent"
			android:layout_height="100dp"
			android:layout_marginTop="8dp"
			android:spacing="20dp" />

		<ImageView
			android:id="@+id/img_custom_preview_map"
			android:layout_width="100dp"
			android:layout_height="100dp"
			android:layout_gravity="center_horizontal"
			android:layout_marginTop="8dp"
			android:scaleType="centerInside"
			android:visibility="gone" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btn_custom_image_map"
			style="@style/Widget.Material3.Button.TonalButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_horizontal"
			android:layout_marginTop="8dp"
			android:text="@string/btn_custom_map_icon" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btn_clear_custom_image_map"
			style="@style/Widget.Material3.Button.TextButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_gravity="center_horizontal"
			android:text="@string/btn_clear_custom_map_icon"
			android:visibility="gone" />
	</LinearLayout>
</ScrollView>