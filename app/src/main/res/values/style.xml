<?xml version="1.0" encoding="UTF-8"?>
<resources>
    <item type="id" name="content"/>
	<style name="Theme.App" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorSurfaceContainer">@color/colorSurfaceContainer</item>
        <item name="colorControlNormal">@color/colorText</item>
        <item name="colorOnSecondaryContainer">@color/colorText</item>
        <item name="preferenceTheme">@style/ThemeOverlay.App.Preference</item>
    </style>

    <style name="Theme.App.WithActionBar" parent="Theme.Material3.DayNight">
        <item name="colorSurfaceContainer">@color/colorSurfaceContainer</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:textColorPrimary">@color/colorText</item>
        <item name="android:textColorSecondary">@color/colorGreyBlue</item>
        <item name="android:textColorPrimaryInverse">@color/colorBackground</item>
        <item name="colorControlNormal">@color/colorText</item>
        <item name="colorOnSecondaryContainer">@color/colorText</item>
        <item name="colorPrimary">#33B5E5</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:actionBarStyle">@style/Theme.App.WithActionBar.ActionBar</item>
        <item name="android:actionBarTheme">@style/Theme.App.WithActionBar.ActionBarTheme</item>
        <item name="windowActionBarOverlay">false</item>
        <item name="android:windowActionBarOverlay">false</item>
        <item name="preferenceTheme">@style/ThemeOverlay.App.Preference</item>
    </style>

    <style name="Theme.App.WithActionBar.ActionBar" parent="Widget.AppCompat.ActionBar">
        <item name="background">@color/colorSurfaceContainer</item>
        <item name="android:background">@color/colorSurfaceContainer</item>
        <item name="titleTextStyle">@style/Theme.App.WithActionBar.ActionBar.Title</item>
    </style>

    <style name="Theme.App.WithActionBar.ActionBarTheme" parent="ThemeOverlay.AppCompat.ActionBar">
        <item name="android:textColorPrimary">@color/colorText</item>
        <item name="android:textColorSecondary">@color/colorGreyBlue</item>
        <item name="colorControlNormal">@color/colorText</item>
    </style>


    <style name="Theme.App.WithActionBar.ActionBar.Title" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/colorText</item>
    </style>

    <style name="Theme.AppDialog" parent="Theme.Material3.DayNight.Dialog.Alert" >
        <item name="android:windowTitleStyle">@style/Theme.AppDialog.DialogWindowTitle</item>
    </style>
    <style name="Theme.AppDialog.DialogWindowTitle" parent="RtlOverlay.DialogWindowTitle.AppCompat">
        <item name="android:padding">20px</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Theme.App2" parent="Theme.App">
        <item name="windowActionModeOverlay">true</item>
        <item name="android:windowBackground">?android:attr/colorBackground</item>
    </style>

    <style name="ThemeOverlay.App.Preference" parent="PreferenceThemeOverlay">
        <item name="switchPreferenceCompatStyle">@style/App.Preference.SwitchPreference</item>
    </style>

    <style name="App.Preference.SwitchPreference" parent="Preference.SwitchPreference.Material">
        <item name="android:widgetLayout">@layout/material3_preference_switch_layout</item>
    </style>

    <style name="PopupMenuListView" parent="@style/Widget.AppCompat.ListView.DropDown">
        <item name="android:background">@color/colorPrimary</item>
        <item name="background">@color/colorPrimary</item>
    </style>

	<style name="SOCOverlayText">
        <item name="android:paddingLeft">4px</item>
        <item name="android:paddingBottom">4px</item>
        <item name="android:textColor">#ffffffff</item>
        <item name="android:textSize">20sp</item>
        <item name="android:shadowColor">#000000</item>
        <item name="android:shadowDx">1</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">1</item>
    </style>
    
    <style name="TabCarImgCar">
        <item name="android:layout_width">304px</item>
        <item name="android:layout_height">606px</item>
        <item name="android:layout_x">114px</item>
        <item name="android:layout_y">0px</item>
    </style>
    
    <style name="TabCarImgLetterBox">
        <item name="android:layout_width">534px</item>
        <item name="android:layout_height">610px</item>
        <item name="android:layout_x">0px</item>
        <item name="android:layout_y">75px</item>
    </style>
    
    <style name="TabCarTextBox">
        <item name="android:layout_width">104px</item>
        <item name="android:layout_height">34px</item>
        <item name="android:textSize">20px</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="TabCarTextOverlay">
        <item name="android:textColor">#ffffffff</item>
        <item name="android:shadowColor">#000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">0</item>
        <item name="android:shadowRadius">3</item>
    </style>

    <style name="TextValue" parent="@android:style/Widget.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    	<item name="android:background">@android:drawable/edit_text</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textAppearance">?android:textAppearanceMedium</item>
    </style>

    <declare-styleable name="BatteryIndicatorView">
        <attr name="bat_borderColor" format="color"/>
        <attr name="bat_infillColor" format="color"/>
        <attr name="bat_percent" format="integer"/>
        <attr name="bat_internalSpacing" format="float"/>
    </declare-styleable>

</resources>